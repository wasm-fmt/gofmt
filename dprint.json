{
	"useTabs": true,
	"indentWidth": 4,
	"lineWidth": 120,
	"newLineKind": "lf",
	"json": {
		"trailingCommas": "never"
	},
	"markdown": {},
	"oxc": {},
	"yaml": {},
	"excludes": [
		"**/*-lock.json",
		"**/node_modules",
		"gofmt.js",
		"gofmt_esm.js",
		"gofmt_node.js",
		"gofmt_vite.js",
		"gofmt_web.d.ts",
		"gofmt_web.js",
		"gofmt.wasm.d.ts",
		"gofmt_factory.js",
		"gofmt_factory.d.ts"
	],
	"plugins": [
		"https://plugins.dprint.dev/json-0.21.1.wasm",
		"https://plugins.dprint.dev/markdown-0.21.1.wasm",
		"https://plugins.dprint.dev/oxc-0.6.0.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
	]
}
